---
const email = "prakhargupta058@gmail.com";
---

<section class="section contact" id="contact">
  <div class="wrap">
    <p class="label">// Contact</p>
    <h2>Let's talk</h2>
    <p class="lead">
      I'm looking for software engineering and robotics internships. If you're hiring, working on something
      that flies, or just want to talk about a project, email is the fastest way to reach me.
    </p>

    <div class="email-row">
      <a class="btn primary" href={`mailto:${email}`}>{email}</a>
      <button class="btn copy" type="button" data-email={email}>Copy email</button>
      <span class="copied" role="status" aria-live="polite"></span>
    </div>

    <ul class="links">
      <li><a href="https://www.linkedin.com/in/prakhar-gupta-199744271/">LinkedIn</a></li>
      <li><a href="https://github.com/pg1590">GitHub</a></li>
      <li><a href="/Prakhar_Gupta_Resume.pdf">Resume (PDF)</a></li>
    </ul>
  </div>
</section>

<style>
  .lead { color: var(--muted); max-width: 40em; margin: -14px 0 28px; font-size: 18px; }
  .email-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .email-row .btn.primary { font-size: 15.5px; padding: 12px 18px; }
  .copy { cursor: pointer; color: var(--text); }
  .copied { font: 400 13px var(--mono); color: var(--accent); }
  .links { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 24px; }
  .links a { font: 500 14.5px var(--mono); color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--line); padding-bottom: 2px; }
  .links a:hover { color: var(--accent); border-color: var(--accent); }
</style>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>("button[data-email]")) {
    const status = b.parentElement!.querySelector<HTMLElement>(".copied")!;
    b.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.email!);
        status.textContent = "Copied";
      } catch {
        status.textContent = b.dataset.email!;   // clipboard blocked: show it to copy by hand
      }
      setTimeout(() => (status.textContent = ""), 2500);
    });
  }
</script>
