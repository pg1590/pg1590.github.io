---
const highlights = [
  "ML Engineer Intern @ Latitude 54",
  "Researcher @ Robotics Research Center",
  "MathWorks Minidrone finalist, 2025",
];
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="intro">
      <p class="label">// Software + Robotics · IIIT Hyderabad</p>
      <h1>Prakhar Gupta</h1>
      <p class="lead">
        I build perception and control software for drones, and the ML and
        full-stack systems around it. Detection models, trackers, and
        controllers that run on real hardware, not only in simulation.
      </p>
      <ul class="highlights">
        {highlights.map((h) => <li>{h}</li>)}
      </ul>
      <div class="ctas">
        <a href="#work" class="btn primary">See my work</a>
        <a href="/Prakhar_Gupta_Resume.pdf" class="btn">Resume</a>
        <a href="https://github.com/pg1590" class="btn">GitHub</a>
        <a href="https://www.linkedin.com/in/prakhar-gupta-199744271/" class="btn">LinkedIn</a>
      </div>
    </div>

    <figure class="feed">
      <div class="feed-bar">
        <span><i class="rec"></i>TELLO ONBOARD</span>
        <span>REC 2026-05-08</span>
      </div>
      <div class="feed-view">
        <video src="/media/rccar.mp4" poster="/media/rccar.jpg" autoplay muted loop playsinline
          aria-label="Onboard Tello camera following a moving RC car; a green box tracks the car while the estimated distance drops from about 2 m to 1 m"></video>
        <span class="corner tl"></span><span class="corner tr"></span>
        <span class="corner bl"></span><span class="corner br"></span>
      </div>
      <figcaption>
        <a href="https://github.com/pg1590/UAV-Project">RC car follower</a>:
        YOLOv8 detection, CSRT tracking, Kalman filter, and PID control. Real flight, onboard camera.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { padding: clamp(48px, 9vw, 104px) 0 clamp(56px, 9vw, 96px); }
  .hero-grid {
    display: grid; gap: clamp(36px, 5vw, 64px);
    grid-template-columns: 1.05fr 1fr; align-items: center;
  }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } }

  h1 { font-size: clamp(40px, 6.4vw, 64px); margin: 16px 0 20px; }
  .lead { font-size: clamp(17px, 2vw, 19.5px); color: var(--muted); max-width: 34em; margin: 0; }

  .highlights { list-style: none; padding: 0; margin: 26px 0 32px; display: grid; gap: 8px; }
  .highlights li { font: 400 14.5px var(--mono); color: var(--text); padding-left: 22px; position: relative; }
  .highlights li::before { content: "▸"; position: absolute; left: 0; color: var(--accent); }

  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }

  .feed { margin: 0; }
  .feed-bar {
    display: flex; justify-content: space-between;
    font: 500 11.5px var(--mono); letter-spacing: 0.1em; color: var(--muted);
    padding: 9px 12px; background: var(--surface);
    border: 1px solid var(--line); border-bottom: 0; border-radius: var(--radius) var(--radius) 0 0;
  }
  .rec {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    background: #ff4d4d; margin-right: 8px; vertical-align: 1px;
    animation: blink 1.6s steps(2) infinite;
  }
  @keyframes blink { 50% { opacity: 0.25; } }
  @media (prefers-reduced-motion: reduce) { .rec { animation: none; } }

  .feed-view {
    position: relative; aspect-ratio: 4 / 3; background: #000;
    border: 1px solid var(--line); border-radius: 0 0 var(--radius) var(--radius); overflow: hidden;
  }
  .feed-view video { width: 100%; height: 100%; object-fit: cover; }
  .corner { position: absolute; width: 18px; height: 18px; border: 2px solid var(--accent); opacity: .85; }
  .tl { top: 10px; left: 10px; border-right: 0; border-bottom: 0; }
  .tr { top: 10px; right: 10px; border-left: 0; border-bottom: 0; }
  .bl { bottom: 10px; left: 10px; border-right: 0; border-top: 0; }
  .br { bottom: 10px; right: 10px; border-left: 0; border-top: 0; }

  figcaption { margin-top: 12px; font-size: 14px; color: var(--muted); }
  figcaption a { color: var(--accent); text-decoration: none; }
  figcaption a:hover { text-decoration: underline; }
</style>
