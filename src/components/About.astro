---
const facts = [
  ["Based in", "Hyderabad, India"],
  ["Studying", "B.Tech + M.S. by Research, ECE, IIIT Hyderabad (2028)"],
  ["Currently", "Swarm drone tracking at the Robotics Research Center"],
];
---

<section class="section" id="about">
  <div class="wrap about">
    <figure class="photo">
      <img src="/media/prakhar.jpg" alt="Prakhar Gupta smiling by a lake, wearing glasses and a red NASA t-shirt" width="640" height="640" loading="lazy" />
      <span class="det" aria-hidden="true"><span>prakhar 0.99</span></span>
    </figure>

    <div class="text">
      <p class="label">// About</p>
      <h2>A bit about me</h2>
      <p>
        I'm an electronics student at IIIT Hyderabad who ended up writing a lot of software. My projects run from
        transistor-level SRAM and FPGA accelerators up to ML models and web apps, and these days most of my time
        goes into robotics: getting drones to see, track, and coordinate, and then checking the flight logs to see
        what actually happened.
      </p>
      <p>
        Away from the keyboard I play chess. I've competed internationally for over 13 years and represented
        India at the Commonwealth Games (<a href="https://ratings.fide.com/profile/35062239">FIDE profile</a>).
        I also led IIIT Hyderabad's dance crew as Head Coordinator, running workshops and university competitions.
      </p>

      <dl class="facts">
        {facts.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: minmax(220px, 340px) 1fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  @media (max-width: 760px) { .about { grid-template-columns: 1fr; } .photo { max-width: 300px; } }

  .photo { margin: 0; position: relative; }
  .photo img { width: 100%; height: auto; border-radius: var(--radius); filter: saturate(0.9); }
  /* a detection box around the face, echoing the YOLO overlay */
  .det {
    position: absolute; left: 24%; top: 6%; width: 50%; height: 56%;
    border: 2px solid var(--accent); border-radius: 2px;
  }
  .det span {
    position: absolute; left: -2px; bottom: 100%;
    background: var(--accent); color: #04140b;
    font: 500 11.5px/1 var(--mono); padding: 4px 6px; white-space: nowrap;
  }

  .text h2 { margin-bottom: 20px; }
  .text p:not(.label) { color: var(--muted); margin: 0 0 16px; max-width: 40em; }
  .text a { color: var(--accent); text-decoration: none; }
  .text a:hover { text-decoration: underline; }

  .facts { margin: 28px 0 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .facts div { display: grid; grid-template-columns: 130px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  @media (max-width: 480px) { .facts div { grid-template-columns: 1fr; gap: 2px; } }
  .facts dt { font: 500 12.5px var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); padding-top: 3px; }
  .facts dd { margin: 0; color: var(--text); }
</style>
